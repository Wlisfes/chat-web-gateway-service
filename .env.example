# Node.js 运行环境； 生产部署使用 production、本地开发使用 development。
NODE_ENV=development
# 网关监听端口 5000。
PORT=5000

# 容器时区；用于统一日志和业务时间。
TZ=Asia/Shanghai
# Nacos 配置中心 Data ID；配置分组默认使用 DEFAULT_GROUP。
NACOS_CONFIG_DATA_ID=chat-web-gateway-service.yaml
# 是否将网关实例注册到 Nacos 服务发现。
NACOS_REGISTER_ENABLED=true
# Nacos 命名空间 ID（不是命名空间显示名称）。
NACOS_NAMESPACE=042221b0-06c9-4b86-9782-3cf30137c663
# Nacos 服务地址，格式为 host:port。
NACOS_SERVER=127.0.0.1:8848
# 网关在 Nacos 服务发现中的服务名称。
NACOS_SERVICE_NAME=chat-web-gateway-service
# Nacos 鉴权密码；真实值只保存在部署主机。
NACOS_PASSWORD=nacos
# Nacos 鉴权用户名。
NACOS_USERNAME=nacos
# Nacos 注册实例权重；可按部署实例覆盖，未配置时使用 1。
NACOS_REGISTER_WEIGHT=1
# 是否启用 Nacos 配置中心订阅。
NACOS_CONFIG_ENABLED=true
# 是否要求 Nacos 配置必须成功加载；为 true 时加载失败将阻止服务启动。
NACOS_CONFIG_REQUIRED=true
# 是否启用 Nacos 服务发现，用于解析网关代理的目标服务实例。
NACOS_DISCOVERY_ENABLED=true
# 是否要求服务发现初始化成功；为 false 时短暂不可用不会阻止网关启动。
NACOS_DISCOVERY_REQUIRED=false
