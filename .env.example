# 本地运行环境。
NODE_ENV=development

# 启动阶段连接 Nacos 配置中心所必需的参数。
NACOS_SERVER=127.0.0.1:8848
NACOS_NAMESPACE=replace-with-nacos-namespace-id
NACOS_CONFIG_DATA_ID=chat-web-gateway-service.yaml
NACOS_CONFIG_GROUP=DEFAULT_GROUP

# Nacos 开启身份认证时填写。
NACOS_USERNAME=
NACOS_PASSWORD=

# Nacos 不可用时的本地后备服务地址。
ACCOUNT_SERVICE_URL=http://127.0.0.1:3000
FINANCE_SERVICE_URL=http://127.0.0.1:3010
CRM_SERVICE_URL=http://127.0.0.1:3020
# 当前节点标识，用于结构化日志区分部署环境。
DEPLOYMENT_ENVIRONMENT=development-local
