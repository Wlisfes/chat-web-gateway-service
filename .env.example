# 根目录 .env 只保存应用启动和连接 Nacos 前必须知道的参数。
NODE_ENV=development
PORT=3999

# 其余网关配置由 Nacos 远端 chat-web-gateway-service.yaml 提供。
NACOS_SERVER=127.0.0.1:8848
NACOS_NAMESPACE=replace-with-nacos-namespace-id

# Nacos 开启鉴权时，这两项也是连接配置，需在读取远端配置前提供。
# NACOS_USERNAME=nacos
# NACOS_PASSWORD=replace-with-nacos-password
