# 本地运行环境。
NODE_ENV=development

# 启动阶段连接 Nacos 配置中心所必需的参数。
NACOS_SERVER=127.0.0.1:8848
NACOS_NAMESPACE=replace-with-nacos-namespace-id
NACOS_CONFIG_DATA_ID=chat-web-gateway-service.yaml
NACOS_CONFIG_GROUP=DEFAULT_GROUP

# Nacos 开启身份认证时填写。
NACOS_USERNAME=
NACOS_PASSWORD=

# Nacos 不可用时的本地后备服务地址。
ACCOUNT_SERVICE_URL=http://127.0.0.1:3000
FINANCE_SERVICE_URL=http://127.0.0.1:3010
CRM_SERVICE_URL=http://127.0.0.1:3020
# Docker 部署会自动预加载 OpenTelemetry；本机进程需要采集时，在启动前设置以下变量。
# NODE_OPTIONS=--require @opentelemetry/auto-instrumentations-node/register
# OTEL_SERVICE_NAME=chat-web-gateway-service
# OTEL_SERVICE_VERSION=local
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp
# OTEL_LOGS_EXPORTER=none
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1
# OTEL_METRIC_EXPORT_INTERVAL=15000
# OTEL_NODE_RESOURCE_DETECTORS=env,host,os,process,serviceinstance,container
# DEPLOYMENT_ENVIRONMENT=development-local
# OTEL_RESOURCE_ATTRIBUTES=service.namespace=chat-web,deployment.environment.name=development-local
