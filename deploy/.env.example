# Docker 部署环境变量；路由、限流、跨域和后备地址统一从云端 Nacos 读取。
# 真实 .env 仅保存在部署主机，不要提交到 Git 仓库。

# 应用启动参数。
NODE_ENV=production
PORT=5000

# Nacos 连接、鉴权和配置订阅参数。
NACOS_SERVER=10.66.0.1:8848
NACOS_SERVICE_NAME=chat-web-gateway-service
NACOS_NAMESPACE=replace-with-nacos-namespace-id
NACOS_CONFIG_DATA_ID=chat-web-gateway-service.yaml
NACOS_USERNAME=nacos
NACOS_PASSWORD=replace-with-nacos-password
# 是否注册服务；注册失败是否阻止启动使用默认值 false。
NACOS_REGISTER_ENABLED=true
# Nacos 注册实例权重；可按部署实例覆盖，未配置时使用 1。
NACOS_REGISTER_WEIGHT=1
