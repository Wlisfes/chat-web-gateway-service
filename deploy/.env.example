# 将此文件复制到 Docker 主机的 /opt/chat-web-gateway-service/.env。
# 真实 .env 只保存在服务器，不要提交到 Git 仓库。

# 当前 Docker 主机特有的部署参数。
TZ=Asia/Shanghai
BIND_ADDRESS=0.0.0.0
HOST_PORT=3999
DOCKER_NETWORK=chat-web-infrastructure

# 启动阶段连接 Nacos 配置中心所必需的参数。
NACOS_SERVER=nacos:8848
NACOS_NAMESPACE=replace-with-nacos-namespace-id
NACOS_CONFIG_DATA_ID=chat-web-gateway-service.yaml
NACOS_CONFIG_GROUP=DEFAULT_GROUP
NACOS_USERNAME=
NACOS_PASSWORD=

# Nacos 没有健康实例时使用同一 Docker 网络内的后备地址。
ACCOUNT_SERVICE_URL=http://chat-web-account-service:3000
FINANCE_SERVICE_URL=http://chat-web-finance-service:3010
CRM_SERVICE_URL=http://chat-web-crm-service:3020

# 跨宿主机使用服务发现时，填写其他节点能够访问的网关 IP；同一 Docker 网络内可留空。
NACOS_REGISTER_IP=
# 当前节点标识，用于结构化日志区分部署环境。
DEPLOYMENT_ENVIRONMENT=production-home
